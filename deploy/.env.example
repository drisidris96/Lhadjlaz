# Copy to /var/www/lhadjlaz/.env on the VPS and fill in values.
# DO NOT commit a real .env to git.

# --- Required ---
DATABASE_URL=postgres://lhadjlaz:CHANGE_ME@127.0.0.1:5432/lhadjlaz

# Long random string. Generate with:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_HEX_STRING

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lhadjlaz@2026

# --- Storage (local mode for VPS) ---
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=/var/lib/lhadjlaz/uploads
PUBLIC_BASE_URL=https://lhadjlaz.publicvm.com

# --- API server runtime ---
PORT=3001
NODE_ENV=production
